@model Material
@{
    ViewData["Title"] = Model.Id == 0 ? "Nuevo material" : "Editar material";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="tarjeta">
            <h1 class="h4 titulo-pagina mb-4">@ViewData["Title"]</h1>
            <form asp-action="Guardar" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej: Breaker 3P 32 A" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="CategoriaId" class="form-label"></label>
                    <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.Categorias">
                        <option value="0">Selecciona…</option>
                    </select>
                    <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Unidad" class="form-label"></label>
                    <input asp-for="Unidad" class="form-control" placeholder="u, m, kg…" />
                    <span asp-validation-for="Unidad" class="text-danger small"></span>
                </div>
                <div class="row">
                    <div class="col-6 mb-3">
                        <label asp-for="Stock" class="form-label"></label>
                        <input asp-for="Stock" type="number" step="0.01" min="0" class="form-control" />
                        <span asp-validation-for="Stock" class="text-danger small"></span>
                    </div>
                    <div class="col-6 mb-3">
                        <label asp-for="CostoUnitario" class="form-label"></label>
                        <input asp-for="CostoUnitario" type="number" step="0.01" min="0" class="form-control" />
                        <span asp-validation-for="CostoUnitario" class="text-danger small"></span>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-app"><i class="bi bi-save me-1"></i>Guardar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
