@model Material
@{
    ViewData["Title"] = "Precios de " + Model.Nombre;
    // aqui marco el proveedor mas barato (el core luego elige este cuando falta stock)
    PrecioProveedor? masBarato = null;
    foreach (var p in Model.Precios)
    {
        if (masBarato == null || p.Precio < masBarato.Precio)
            masBarato = p;
    }
}

<a asp-action="Index" class="btn btn-link px-0 mb-2"><i class="bi bi-arrow-left"></i> Volver a materiales</a>
<h1 class="h3 titulo-pagina">Precios: @Model.Nombre</h1>
<p class="subtitulo mb-4">Stock en bodega: <b>@Model.Stock.ToString("0.##") @Model.Unidad</b> a $@Model.CostoUnitario.ToString("N2") c/u.</p>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="tarjeta p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0 tabla">
                    <thead>
                        <tr>
                            <th class="ps-4">Proveedor</th>
                            <th class="text-end">Precio</th>
                            <th class="text-end">Días de entrega</th>
                            <th class="pe-4"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Precios.OrderBy(x => x.Precio))
                        {
                            <tr>
                                <td class="ps-4">
                                    @p.Proveedor!.Nombre
                                    @if (p == masBarato)
                                    {
                                        <span class="badge text-bg-success ms-1">Más barato</span>
                                    }
                                </td>
                                <td class="text-end">$@p.Precio.ToString("N2")</td>
                                <td class="text-end">@p.DiasEntrega</td>
                                <td class="text-end pe-4">
                                    <form asp-action="QuitarPrecio" asp-route-id="@p.Id" method="post" class="d-inline">
                                        <button class="btn btn-sm btn-outline-danger" title="Quitar"><i class="bi bi-x-lg"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!Model.Precios.Any())
                        {
                            <tr><td colspan="4" class="text-center subtitulo py-4">Ningún proveedor tiene precio registrado para este material.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="tarjeta">
            <h2 class="h6 fw-semibold mb-3">Agregar o actualizar precio</h2>
            @if (((Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.Proveedores).Any())
            {
                <form asp-action="AgregarPrecio" method="post">
                    <input type="hidden" name="MaterialId" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label" for="ProveedorId">Proveedor</label>
                        <select name="ProveedorId" id="ProveedorId" class="form-select" asp-items="ViewBag.Proveedores" required>
                            <option value="">Selecciona…</option>
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label" for="Precio">Precio</label>
                            <input type="number" step="0.01" min="0.01" name="Precio" id="Precio" class="form-control" required />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label" for="DiasEntrega">Días</label>
                            <input type="number" min="0" max="365" name="DiasEntrega" id="DiasEntrega" class="form-control" required />
                        </div>
                    </div>
                    <button class="btn btn-app w-100"><i class="bi bi-plus-lg me-1"></i>Guardar precio</button>
                </form>
            }
            else
            {
                <p class="subtitulo mb-0">Primero registra proveedores en <a asp-controller="Proveedores" asp-action="Crear">Proveedores</a>.</p>
            }
        </div>
    </div>
</div>
