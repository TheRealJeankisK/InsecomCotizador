@model (string Accion, int Id, string Nombre)
@* boton de eliminar por post con confirmacion (lo usan todas las tablas) *@
<form asp-action="@Model.Accion" asp-route-id="@Model.Id" method="post" class="d-inline"
      data-nombre="@Model.Nombre" onsubmit="return confirm('¿Seguro que quieres eliminar ' + this.dataset.nombre + '?');">
    <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></button>
</form>
