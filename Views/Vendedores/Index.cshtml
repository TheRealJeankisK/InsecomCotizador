@model List<Vendedor>
@{
    ViewData["Title"] = "Vendedores";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 titulo-pagina">Vendedores</h1>
        <span class="subtitulo">@Model.Count vendedor(es)</span>
    </div>
    <a asp-action="Crear" class="btn btn-app"><i class="bi bi-plus-lg me-1"></i>Nuevo vendedor</a>
</div>

<div class="tarjeta p-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 tabla">
            <thead>
                <tr>
                    <th class="ps-4">Nombre</th>
                    <th>Correo</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model)
                {
                    <tr>
                        <td class="ps-4 fw-semibold">@v.Nombre</td>
                        <td>@v.Correo</td>
                        <td class="text-end pe-4 text-nowrap">
                            <a asp-action="Editar" asp-route-id="@v.Id" class="btn btn-sm btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i></a>
                            <partial name="_BotonEliminar" model="@(("Eliminar", v.Id, v.Nombre))" />
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="3" class="text-center subtitulo py-4">No hay vendedores registrados.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
