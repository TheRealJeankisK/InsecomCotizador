@model ReglaComision
@{
    ViewData["Title"] = Model.Id == 0 ? "Nueva regla" : "Editar regla";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="tarjeta">
            <h1 class="h4 titulo-pagina mb-4">@ViewData["Title"]</h1>
            <form asp-action="Guardar" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />
                <div class="row">
                    <div class="col-6 mb-3">
                        <label asp-for="MontoMinimo" class="form-label"></label>
                        <input asp-for="MontoMinimo" type="number" step="0.01" min="0" class="form-control" />
                        <span asp-validation-for="MontoMinimo" class="text-danger small"></span>
                    </div>
                    <div class="col-6 mb-3">
                        <label asp-for="MontoMaximo" class="form-label"></label>
                        <input asp-for="MontoMaximo" type="number" step="0.01" min="0" class="form-control" />
                        <div class="form-text">Vacío = sin tope.</div>
                        <span asp-validation-for="MontoMaximo" class="text-danger small"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Porcentaje" class="form-label">Porcentaje (%)</label>
                    <input asp-for="Porcentaje" type="number" step="0.01" min="0" max="100" class="form-control" />
                    <span asp-validation-for="Porcentaje" class="text-danger small"></span>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-app"><i class="bi bi-save me-1"></i>Guardar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
