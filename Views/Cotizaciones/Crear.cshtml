@model Cotizacion
@{
    ViewData["Title"] = "Nueva cotización";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="tarjeta">
            <h1 class="h4 titulo-pagina mb-1">Nueva cotización</h1>
            <p class="subtitulo mb-4">Paso 1: elige el cliente y el vendedor. Luego agregas los productos.</p>
            <form asp-action="Crear" method="post">
                <div class="mb-3">
                    <label asp-for="ClienteId" class="form-label"></label>
                    <select asp-for="ClienteId" asp-items="ViewBag.Clientes" class="form-select">
                        <option value="0">Selecciona…</option>
                    </select>
                    <span asp-validation-for="ClienteId" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="VendedorId" class="form-label"></label>
                    <select asp-for="VendedorId" asp-items="ViewBag.Vendedores" class="form-select">
                        <option value="0">Selecciona…</option>
                    </select>
                    <span asp-validation-for="VendedorId" class="text-danger small"></span>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-app"><i class="bi bi-arrow-right me-1"></i>Continuar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
