@model Configuracion
@{
    ViewData["Title"] = "Margen e IVA";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="tarjeta">
            <h1 class="h4 titulo-pagina">Margen e IVA</h1>
            <p class="subtitulo mb-4">Se usan en la fórmula: precio sugerido = costo × (1 + margen) × (1 + IVA).</p>
            <form asp-action="Index" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="mb-3">
                    <label asp-for="Margen" class="form-label"></label>
                    <input asp-for="Margen" type="number" step="0.01" min="0" class="form-control" />
                    <span asp-validation-for="Margen" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="IVA" class="form-label"></label>
                    <input asp-for="IVA" type="number" step="0.01" min="0" max="100" class="form-control" />
                    <span asp-validation-for="IVA" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-app"><i class="bi bi-save me-1"></i>Guardar</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
