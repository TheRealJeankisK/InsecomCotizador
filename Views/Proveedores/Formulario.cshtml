@model Proveedor
@{
    ViewData["Title"] = Model.Id == 0 ? "Nuevo proveedor" : "Editar proveedor";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="tarjeta">
            <h1 class="h4 titulo-pagina mb-4">@ViewData["Title"]</h1>
            <form asp-action="Guardar" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Contacto" class="form-label"></label>
                    <input asp-for="Contacto" class="form-control" placeholder="Teléfono o correo" />
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-app"><i class="bi bi-save me-1"></i>Guardar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
